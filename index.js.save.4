                    `  └ Example: !weather Bushbuckridge\n` +
                    `• !qr <text/link> : Generate a scannable QR code image. *(AI-Free)*\n` +
                    `  └ Example: !qr https://google.com\n` +
                    `• !todo <task> : Add a task to your chat to-do list. *(AI-Free)*\n` +
                    `• !todos : View your active chat to-do list. *(AI-Free)*\n` +
                    `• !cleartodos : Clear your chat to-do list. *(AI-Free)*\n\n` +
                    `👥 *GROUP TOOLS*\n` +
                    `• !tagall <msg> : Mention all group members visibly. *(AI-Free)*\n` +
                    `• !hidetag <msg> : Invisible mass group mention. *(AI-Free)*\n\n` +
                    `🔓 *AUTOMATION & CONTROLS*\n` +
                    `• !Neymar : Sleep / Wake bot toggle. *(AI-Free)*\n` +
                    `• View Once Saver : Auto-captures View-Once media. *(AI-Free)*\n` +
                    `• Anti-Delete Recovery : Auto-reposts deleted texts. *(AI-Free)*\n` +
                    `• Background Logger : Silently indexes chat activity. *(AI-Free)*\n` +
                    `───────────────────────────`;
                await sock.sendMessage(remoteJid, { text: menuText });
                continue;
            }

            if (baseWord === 'ai') {
                const prompt = text.replace(/^[!]?ai\s*/i, '').trim();
                if (!prompt) {
                    await sock.sendMessage(remoteJid, { text: 'Please ask a question! Example: ai What is gravity?' });
                    continue;
                }
                try {
                    const response = await callGemini({ model: 'gemini-1.5-flash', contents: prompt });
                    await sock.sendMessage(remoteJid, { text: response.text });
                } catch (err) {
                    await sock.sendMessage(remoteJid, { text: `❌ AI Error: ${err.message}` });
                }
            }

            if (baseWord === 'map' || baseWord === 'nav') {
                const query = text.replace(/^[!]?(map|nav)\s*/i, '').trim();
